/**
 * DEPRECATED: This file is kept for reference purposes only.
 * 
 * The functionality has been migrated to run-telegram-bot-adapter.ts
 * which uses the hexagonal architecture approach with the TelegramAdapter.
 * 
 * Please use "npm run telegram-bot-adapter" instead of "npm run telegram-bot".
 */

// Original content moved from run-telegram-bot.ts
import 'dotenv/config';
import { logger } from './utils/logging';
import { TelegramService } from './services/telegram';
import { initializeDatabase } from './utils/db-migration';
import { DatabaseService } from './services/database';
import { tradeRepository } from './repositories/trade-repository';
import { getEnv } from './utils/env';

// Validate that the token of Telegram is configured
if (!process.env.TELEGRAM_BOT_TOKEN) {
  logger.error('TELEGRAM_BOT_TOKEN no está configurado en el archivo .env');
  process.exit(1);
}

// Validate that there are authorized users
if (!process.env.TELEGRAM_AUTHORIZED_USERS) {
  logger.warn('TELEGRAM_AUTHORIZED_USERS no está configurado. Solo los administradores podrán usar el bot.');
}

async function main() {
  try {
    // 1. Initialize the database (create tables and migrations)
    logger.info('Inicializando base de datos y tablas...');
    
    // Configure database instance before initialization
    const config = getEnv();
    DatabaseService.getInstance({
      connectionString: config.DATABASE_URL || 'postgresql://postgres:postgres@localhost:5432/midasts',
      ssl: config.DATABASE_SSL,
      max: config.DATABASE_MAX_CONNECTIONS,
      idleTimeoutMillis: config.DATABASE_IDLE_TIMEOUT
    });
    
    // 1. Initialize database
    let dbInitialized = false;
    try {
      dbInitialized = await initializeDatabase();
      if (dbInitialized) {
        logger.info('✅ Base de datos PostgreSQL inicializada correctamente');
      } else {
        logger.warn('⚠️ No se pudo inicializar la base de datos PostgreSQL');
        logger.warn('El bot funcionará en modo memoria sin persistencia');
      }
    } catch (error) {
      logger.warn('⚠️ Error al inicializar la base de datos, continuando en modo memoria');
      logger.warn('El bot funcionará con funcionalidad limitada sin persistencia');
    }
    
    // 2. Initialize and start the Telegram service
    logger.info('Inicializando el bot de Telegram...');
    const telegramService = new TelegramService();
    
    // 3. Configure signal handling for controlled shutdown
    process.once('SIGINT', () => telegramService.stop('SIGINT'));
    process.once('SIGTERM', () => telegramService.stop('SIGTERM'));
    
    // 4. Start the bot
    await telegramService.start();
    
    // 5. Send startup notification to administrators
    const adminUsers = process.env.TELEGRAM_ADMIN_USERS ? 
      process.env.TELEGRAM_ADMIN_USERS.split(',').map(id => parseInt(id.trim())) : [];
    
    if (adminUsers.length > 0) {
      await telegramService.sendNotificationToAll('🤖 Bot de MidasTS iniciado correctamente.');
      
      // Add database information to the message
      if (dbInitialized) {
        await telegramService.sendNotificationToAll('✅ Base de datos inicializada correctamente');
      } else {
        await telegramService.sendNotificationToAll('⚠️ Advertencia: Base de datos no disponible. Funcionalidad limitada.');
      }
    }
    
    logger.info('Bot de Telegram iniciado correctamente');
  } catch (error) {
    logger.error({ error }, 'Error al iniciar el bot de Telegram');
    process.exit(1);
  }
}

// Execute the main function
main().catch(error => {
  logger.fatal({ error }, 'Error fatal al iniciar el bot de Telegram');
  process.exit(1);
});
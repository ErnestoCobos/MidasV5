# Configuración de midasTS
# Copia este archivo como .env y ajusta los valores según tu entorno

# API Keys
BINANCE_KEY=tu_api_key_de_binance
BINANCE_SECRET=tu_api_secret_de_binance
LUNAR_KEY=tu_api_key_de_lunarcrush
DEEPSEEK_API_KEY=tu_api_key_de_deepseek

# Entorno
NODE_ENV=development           # development, production, test
LOG_LEVEL=info                 # trace, debug, info, warn, error, fatal
DRY_RUN=true                   # true para operaciones simuladas, false para operaciones reales

# PostgreSQL (conexión a base de datos)
DATABASE_URL=postgres://vultradmin:AVNS_zBGNTQuTGII6zzEqP8i@vultr-prod-c887c024-0af5-4d3e-811c-063368f8c475-vultr-prod-09bb.vultrdb.com:16751/defaultdb
DATABASE_SSL=true             # true para conexión segura
DATABASE_MAX_CONNECTIONS=20   # máximo número de conexiones en el pool
DATABASE_IDLE_TIMEOUT=30000   # timeout en ms para conexiones inactivas

# Migración de datos
MIGRATE_DATA=false            # establecer en true para migrar datos de JSON a PostgreSQL al iniciar
BACKUP_JSON_FILES=true        # realizar copias de seguridad de archivos JSON durante la migración

# TimescaleDB (opcional)
USE_TIMESCALE=true            # true para utilizar TimescaleDB si está disponible
TIMESCALE_CHUNK_INTERVAL_DAYS=1    # intervalo en días para chunks de TimescaleDB
TIMESCALE_COMPRESSION_AFTER_DAYS=7 # días después de los cuales comprimir datos

# Monitoreo y seguimiento de errores
SENTRY_DSN=                   # URL de Sentry para seguimiento de errores (opcional)
SENTRY_ENVIRONMENT=development # entorno para Sentry

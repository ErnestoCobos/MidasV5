{
  "name": "midas",
  "version": "5.1.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "telegram-bot": "ts-node src/run-telegram-bot.ts",
    "telegram-bot-adapter": "ts-node src/run-telegram-bot-adapter.ts",
    "worker-system": "ts-node src/index.ts",
    "worker-simple": "ts-node src/examples/simple-thread-test.ts",
    "worker-diagnostics": "ts-node src/examples/worker-system-diagnostics.ts",
    "test": "jest",
    "test:unit": "jest \"tests/unit/\"",
    "test:integration": "jest \"tests/integration/\"",
    "test:e2e": "jest \"tests/e2e/\"",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:watch:unit": "jest --watch \"tests/unit/\"",
    "test:generate": "ts-node scripts/generate-tests.js",
    "coverage:view": "open coverage/index.html",
    "coverage:summary": "node scripts/generate-coverage-summary.js",
    "coverage:badge": "node scripts/generate-coverage-badge.js",
    "docs": "typedoc",
    "docs:update": "node scripts/update-docs.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:circular": "madge --circular --extensions ts src",
    "check:circular:image": "madge --circular --extensions ts --image madge-graph.svg src",
    "check:architecture": "node scripts/architecture-guard.js",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "@binance/spot": "^4.0.0",
    "@binance/types": "^1.0.2",
    "@langchain/deepseek": "^0.0.1",
    "@sentry/node": "^9.15.0",
    "@sentry/tracing": "^7.120.3",
    "axios": "^1.9.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "langchain": "^0.3.24",
    "node-cache": "^5.1.2",
    "p-queue": "^8.1.0",
    "p-throttle": "^7.0.0",
    "pg": "^8.15.6",
    "pg-promise": "^11.13.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "prompts": "^2.4.2",
    "reflect-metadata": "^0.1.13",
    "technicalindicators": "^3.1.0",
    "telegraf": "^4.16.3",
    "tsyringe": "^4.10.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/js": "^8.56.0",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/git": "^10.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@types/p-throttle": "^1.1.0",
    "@types/prompts": "^2.4.9",
    "eslint": "^8.56.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "jest": "^29.7.0",
    "madge": "^6.1.0",
    "prettier": "^3.1.0",
    "semantic-release": "^21.0.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "typedoc": "^0.26.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^7.0.0"
  },
  "private": true
}
